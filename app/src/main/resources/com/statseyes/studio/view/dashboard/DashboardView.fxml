<?xml version="1.0" encoding="UTF-8"?>
<?import com.statseyes.studio.presentation.component.StatsCard?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.statseyes.studio.presentation.dashboard.DashboardViewController"
      spacing="20">
    
    <StackPane styleClass="hero-panel" HBox.hgrow="ALWAYS" prefHeight="360">
        <ImageView fx:id="clubLogoBackground" fitWidth="480" preserveRatio="true" opacity="0.9"/>
        <StackPane styleClass="hero-overlay"/>
        <VBox alignment="BOTTOM_LEFT" style="-fx-padding: 24;" spacing="10">
            <Label fx:id="clubNameLabel" text="NOM DU CLUB" styleClass="hero-title"/>
            <HBox spacing="8">
                <Label text="Athletes" styleClass="hero-pill"/>
                <Label text="Équipes" styleClass="hero-pill"/>
                <Label text="Séances" styleClass="hero-pill"/>
            </HBox>
        </VBox>
    </StackPane>
    
    <GridPane hgap="16" vgap="16" prefWidth="360">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <StatsCard fx:id="athletesCountCard" title="Athletes" iconGlyph="fas-user" accentColor="#4F8EF7" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <StatsCard fx:id="teamsCountCard" title="Equipes" iconGlyph="fas-users" accentColor="#34C759" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <StatsCard fx:id="sessionsCountCard" title="Seances importees" iconGlyph="fas-download" accentColor="#FFB020" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <StatsCard fx:id="lastImportCard" title="Dernier import" iconGlyph="fas-clock" accentColor="#FF5A5F" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>
</HBox>