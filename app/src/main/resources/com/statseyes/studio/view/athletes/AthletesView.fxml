<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.statseyes.studio.presentation.athletes.listing.AthletesViewController"
      styleClass="athletes-root"
      stylesheets="@/com/statseyes/studio/static/css/athlete/athletes.css"
      spacing="16">
    
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Athletes" styleClass="section-title" HBox.hgrow="ALWAYS"/>
        <Button text="+ Ajouter" onAction="#onAddAthlete" styleClass="primary-button"/>
    </HBox>
    
    <Label fx:id="errorLabel" styleClass="error-text" managed="false" visible="false"/>
    
    <ListView fx:id="athleteListView" styleClass="athlete-list" VBox.vgrow="ALWAYS"/>
</VBox>