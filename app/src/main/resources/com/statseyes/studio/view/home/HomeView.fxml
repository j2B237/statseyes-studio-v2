<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.statseyes.studio.presentation.home.HomeViewController"
            styleClass="home-root"
            stylesheets="@../../static/css/home/home.css">
    
    <left>
        <VBox styleClass="home-sidebar" spacing="4" prefWidth="220">
            <HBox styleClass="brand-row" spacing="10" alignment="CENTER_LEFT">
                <Label text="👁" styleClass="brand-icon"/>
                <VBox>
                    <Label text="StatsEyes" styleClass="brand-name"/>
                    <Label text="Studio" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            
            <Button styleClass="nav-item, selected" text="🏠  Accueil" onAction="#onDashboardClicked"/>
            <Label fx:id="clubsLabel" styleClass="nav-item" text="🏢  Clubs" onMouseClicked="#handleSidebarClick"/>
            <Label fx:id="teamsLabel" styleClass="nav-item" text="👥  Équipes" onMouseClicked="#handleSidebarClick"/>
            <Label fx:id="athletesLabel" styleClass="nav-item" text="👤  Joueurs" onMouseClicked="#handleSidebarClick"/>
            <Label fx:id="sessionsLabel" styleClass="nav-item" text="📊  Analytiques" onMouseClicked="#handleSidebarClick"/>
        </VBox>
    </left>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 24;">
            
            <HBox styleClass="home-topbar" spacing="16" alignment="CENTER_LEFT">
                <TextField promptText="Rechercher un athlete, une equipe..." styleClass="home-search" HBox.hgrow="ALWAYS"/>
                <Label text="🔔"/>
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="userNameLabel" styleClass="home-username" text="Nom Utilisateur"/>
                    <Label text="Préparateur" styleClass="home-userrole"/>
                </VBox>
            </HBox>
            
            <fx:include source="../template/TemplateView.fxml"/>
        </VBox>
    </center>
</BorderPane>