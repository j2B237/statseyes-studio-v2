<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.statseyes.studio.presentation.home.HomeViewController"
            styleClass="home-root"
            stylesheets="@../../static/css/home/home.css">
    
    <left>
        <VBox styleClass="home-sidebar" spacing="18" prefWidth="64">
            <Button styleClass="home-sidebar-icon, selected" text="▦" onAction="#onDashboardClicked"/>
            <Label fx:id="teamsLabel" styleClass="home-sidebar-icon" text="👥" onMouseClicked="#handleSidebarClick"/>
            <Label fx:id="athletesLabel" styleClass="home-sidebar-icon" text="👤" onMouseClicked="#handleSidebarClick"/>
            <Label fx:id="sessionsLabel" styleClass="home-sidebar-icon" text="📊" onMouseClicked="#handleSidebarClick"/>
            <Label styleClass="home-sidebar-icon" text="⚙"/>
        </VBox>
    </left>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 24;">
            
            <HBox styleClass="home-topbar" spacing="16" alignment="CENTER_LEFT">
                <TextField promptText="Rechercher un athlete, une equipe..." styleClass="home-search" HBox.hgrow="ALWAYS"/>
                <Label text="🔔"/>
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="userNameLabel" styleClass="home-username" text="Nom Utilisateur"/>
                    <Label text="Préparateur" styleClass="home-userrole"/>
                </VBox>
            </HBox>
            
            <fx:include source="../template/TemplateView.fxml"/>
        </VBox>
    </center>
</BorderPane>