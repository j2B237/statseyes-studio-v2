<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.statseyes.studio.presentation.athletes.search.AthleteSearchViewController"
      styleClass="athletes-root"
      stylesheets="@/com/statseyes/studio/static/css/athlete/athletes.css"
      spacing="16">
    
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Recherche d'athlètes" styleClass="section-title"/>
        <Label fx:id="countLabel" styleClass="search-count"/>
    </HBox>
    
    <HBox styleClass="filter-bar" spacing="12" alignment="CENTER_LEFT">
        <ChoiceBox fx:id="teamFilterChoiceBox" prefWidth="190"/>
        <ChoiceBox fx:id="positionFilterChoiceBox" prefWidth="190"/>
        <ChoiceBox fx:id="statusFilterChoiceBox" prefWidth="230"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Réinitialiser les filtres" onAction="#onResetFilters" styleClass="secondary-button"/>
    </HBox>
    
    <Label fx:id="errorLabel" styleClass="search-error" wrapText="true"/>
    <Label fx:id="emptyLabel" styleClass="empty-state" wrapText="true"
           text="Aucun athlète ne correspond. Modifiez la recherche ou réinitialisez les filtres."/>
    
    <ListView fx:id="athleteListView" styleClass="athlete-list" VBox.vgrow="ALWAYS"/>
</VBox>