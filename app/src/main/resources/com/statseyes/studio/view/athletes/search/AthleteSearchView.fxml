<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.statseyes.studio.presentation.athletes.search.AthleteSearchViewController"
            stylesheets="@/com/statseyes/studio/static/css/athlete/athlete-details.css"
            styleClass="athlete-details-scroll" fitToWidth="true">
    
    <VBox spacing="10.0">
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
        </padding>
        <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </VBox.margin>
        <GridPane alignment="CENTER_LEFT" hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
            <Label text="Filtres">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
            </Label>
            <Label text="Équipes" GridPane.rowIndex="1">
                <font>
                    <Font name="DejaVu Sans Bold" size="13.0"/>
                </font>
            </Label>
            <ChoiceBox fx:id="teamFilterChoiceBox" prefWidth="150.0" GridPane.rowIndex="2">
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
            </ChoiceBox>
            <Label text="Position" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <font>
                    <Font name="DejaVu Sans Bold" size="13.0"/>
                </font>
            </Label>
            <ChoiceBox fx:id="positionFilterChoiceBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
            </ChoiceBox>
            <Label text="Disponible pour transfert" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <font>
                    <Font name="DejaVu Sans Bold" size="13.0"/>
                </font>
            </Label>
            <ChoiceBox fx:id="statusFilterChoiceBox" prefWidth="150.0" GridPane.columnIndex="2" GridPane.rowIndex="2">
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
            </ChoiceBox>
        </GridPane>
        
        <Separator prefWidth="200.0" />
        <ListView fx:id="athleteListView" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>
        </ListView>
    </VBox>
</ScrollPane>