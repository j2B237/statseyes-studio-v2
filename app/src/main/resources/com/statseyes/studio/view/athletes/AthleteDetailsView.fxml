<?xml version="1.0" encoding="UTF-8"?>
<?import com.statseyes.studio.presentation.component.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<?import javafx.scene.shape.Rectangle?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.statseyes.studio.presentation.athletes.details.AthleteDetailsViewController"
            styleClass="athlete-details-scroll"
            stylesheets="@/com/statseyes/studio/static/css/athlete/athlete-details.css"
            fitToWidth="true">
    
    <VBox styleClass="athlete-details-root" spacing="20" style="-fx-padding: 24;">
        
        <Button text="← Retour aux athletes" onAction="#onBack" styleClass="secondary-button"/>
        
        <HBox fx:id="availabilityBanner" styleClass="availability-banner" alignment="CENTER_LEFT">
            <Label fx:id="bannerLabel" styleClass="availability-banner-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Hyperlink text="Modifier" styleClass="availability-banner-link" onAction="#onEditAvailability"/>
        </HBox>
        
        <HBox spacing="5" alignment="CENTER_LEFT" styleClass="session-banner">
            
            <StackPane>
                <Rectangle width="110" height="110" styleClass="athlete-photo-placeholder"/>
                <ImageView fx:id="athletePhotoView" fitWidth="110" fitHeight="110"/>
            </StackPane>
            
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="athleteNameLabel" styleClass="athlete-name" text="—"/>
                    <Label fx:id="athleteJerseyLabel" styleClass="athlete-meta"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="athleteFlagLabel" styleClass="country-code"/>
                    <Label fx:id="athleteNationalityLabel" styleClass="athlete-meta"/>
                    <Label fx:id="athleteTeamLabel" styleClass="athlete-meta"/>
                </HBox>
                <FlowPane fx:id="positionsPane" hgap="6" vgap="6"/>
                <Label fx:id="physicalLine" styleClass="player-meta"/>
            </VBox>
            
            <VBox alignment="TOP_RIGHT" spacing="10">
                <Label fx:id="statusBadge" styleClass="status-badge"/>
                <ToggleButton fx:id="transferToggle" styleClass="transfer-toggle" onAction="#onToggleTransfer"/>
            </VBox>
            
            <VBox styleClass="pod-status-card" spacing="10">
                <VBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER">
                        <Circle radius="4" styleClass="status-dot-active"/>
                        <Label text="StatsEyes Pod " styleClass="pod-status-title"/>
                    </HBox>
                    <VBox spacing="8">
                        <Label text="Dernière synchronisation" styleClass="pod-status-subtitle"/>
                        <Label fx:id="lastImportDateLabel" styleClass="pod-status-value"/>
                    </VBox>
                </VBox>
                
                <HBox alignment="CENTER_LEFT" styleClass="pod-status-link" onMouseClicked="#onViewAnalytics">
                    <VBox>
                        <Label text="Données disponibles" styleClass="pod-status-label"/>
                        <Label fx:id="importedSessionsCountLabel" styleClass="pod-status-value-link" text="—"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="›" styleClass="pod-status-chevron"/>
                </HBox>
                <Button styleClass="primary-button" fx:id="importButton" text="Importer session" onAction="#onImportDump"/>
            </VBox>
        </HBox>
        
        <Label fx:id="importStatusLabel" styleClass="import-status"/>
        
        <!-- SESSION BANNER -->
        <HBox styleClass="session-banner" spacing="16" alignment="CENTER_LEFT">
            <Label fx:id="sessionDateLabel" styleClass="session-banner-title"/>
            <Label text="Entraînement" styleClass="session-type-badge"/>
            <Label text="Durée" styleClass="side-panel-label"/>
            <Label fx:id="sessionDurationLabel" styleClass="side-panel-value"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="sessionLocationLabel" styleClass="session-banner-location"/>
        </HBox>
        
        <!-- STATS CARD -->
        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>
            <StatsCard fx:id="distanceCard" title="Distance" iconGlyph="fas-map-marker-alt" accentColor="#4F8EF7" GridPane.columnIndex="0"/>
            <StatsCard fx:id="vitesseCard" title="Vitesse max" iconGlyph="fas-running" accentColor="#FF5A5F" GridPane.columnIndex="1"/>
            <StatsCard fx:id="sprintsCard" title="Sprints" iconGlyph="fas-bolt" accentColor="#FFB020" GridPane.columnIndex="2"/>
            <StatsCard fx:id="directionCard" title="Direction" iconGlyph="fas-compass" accentColor="#34C759" GridPane.columnIndex="3"/>
        </GridPane>
        
        <!-- ONGLETS ET PANNEAUX LATÉRAUX -->
        <HBox spacing="20">
            <TabPane styleClass="athlete-tabs" HBox.hgrow="ALWAYS">
                <Tab text="Carte de chaleur" closable="false">
                    <VBox style="-fx-padding: 16;">
                        <HBox spacing="20">
                            <HeatmapCanvas fx:id="heatmapCanvas"/>
                            <VBox alignment="CENTER" spacing="4">
                                <Label text="Intensité élevée" styleClass="heatmap-legend-label"/>
                                <Region styleClass="heatmap-legend-gradient" prefWidth="12" prefHeight="300"/>
                                <Label text="Intensité faible" styleClass="heatmap-legend-label"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </Tab>
                <Tab text="Historique des séances" closable="false" >
                    <ListView fx:id="sessionHistoryListView" styleClass="session-history-list"/>
                </Tab>
                <Tab text="Profil" closable="false">
                    <HBox spacing="24">
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            <Label text="Profil sportif" styleClass="section-title"/>
                            <Label text="Pied fort" styleClass="field-label"/>
                            <HBox spacing="10">
                                <ToggleButton fx:id="footLeft"  text="Gauche"    styleClass="foot-option" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <ToggleButton fx:id="footRight" text="Droit"     styleClass="foot-option" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <ToggleButton fx:id="footBoth"  text="Les deux"  styleClass="foot-option" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                            <Label text="Poste principal" styleClass="field-label"/>
                            <ComboBox fx:id="mainPositionCombo" maxWidth="Infinity"/>
                            <Label text="Postes secondaires" styleClass="field-label"/>
                            <FlowPane fx:id="secondaryPane" hgap="6" vgap="6" styleClass="chips-field"/>
                            <ComboBox fx:id="addSecondaryCombo" promptText="+ Ajouter un poste" maxWidth="Infinity"/>
                            <HBox alignment="CENTER_RIGHT"><Button text="Enregistrer" styleClass="primary-button" onAction="#onSaveProfile"/></HBox>
                        </VBox>
                        
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Disponibilité" styleClass="section-title"/>
                            <HBox styleClass="kv-row">
                                <Label text="Statut" styleClass="kv-key" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="profileStatusBadge" styleClass="status-badge"/>
                            </HBox>
                            <HBox styleClass="kv-row">
                                <Label text="Motif" styleClass="kv-key" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="reasonLabel" styleClass="kv-value"/>
                            </HBox>
                            <HBox styleClass="kv-row">
                                <Label text="Depuis le" styleClass="kv-key" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="sinceLabel" styleClass="kv-value"/>
                            </HBox>
                            <HBox styleClass="kv-row">
                                <Label text="Retour prévu" styleClass="kv-key" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="returnLabel" styleClass="kv-value"/>
                            </HBox>
                            <Button text="Modifier la disponibilité" styleClass="secondary-button" onAction="#onEditAvailability"/>
                            
                            <Label text="Informations personnelles" styleClass="section-title" style="-fx-padding: 18 0 0 0;"/>
                            <HBox styleClass="kv-row">
                                <Label text="Date de naissance" styleClass="kv-key" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="profileBirthLabel" styleClass="kv-value"/>
                            </HBox>
                            <HBox styleClass="kv-row">
                                <Label text="Nationalité" styleClass="kv-key" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="profileNationalityLabel" styleClass="kv-value"/>
                            </HBox>
                            <HBox styleClass="kv-row">
                                <Label text="Équipe" styleClass="kv-key" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="profileTeamLabel" styleClass="kv-value"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </Tab>
                <Tab text="Comparer" closable="false">
                    <VBox spacing="16" style="-fx-padding: 16;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ChoiceBox fx:id="sessionAChoice" prefWidth="200"/>
                            <Label text="vs"/>
                            <ChoiceBox fx:id="sessionBChoice" prefWidth="200"/>
                            <Button text="Comparer" onAction="#onCompare" styleClass="primary-button"/>
                        </HBox>
                        <VBox fx:id="comparisonRowsContainer" spacing="8"/>
                    </VBox>
                </Tab>
            </TabPane>
            
            <VBox spacing="20" prefWidth="280" minWidth="280">
                <!-- Informations de la séance -->
                <VBox styleClass="side-panel" spacing="12">
                    <Label text="Informations de la séance" styleClass="side-panel-title"/>
                    <HBox styleClass="side-panel-row">
                        <Label text="Date" styleClass="side-panel-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="sessionInfoDateLabel" styleClass="side-panel-value"/>
                    </HBox>
                    <HBox styleClass="side-panel-row">
                        <Label text="Durée" styleClass="side-panel-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statDurationLabel" text="—" styleClass="side-panel-value"/>
                    </HBox>
                    <HBox styleClass="side-panel-row">
                        <Label text="Type" styleClass="side-panel-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Entrainement" styleClass="side-panel-value"/>
                    </HBox>
                    <HBox styleClass="side-panel-row">
                        <Label text="Lieu" styleClass="side-panel-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Dakar" styleClass="side-panel-value"/>
                    </HBox>
                </VBox>
                
                <!-- statistiques complémentaires -->
                <VBox styleClass="side-panel" spacing="12">
                    <Label text="statistiques complémentaires" styleClass="side-panel-title"/>
                    <HBox styleClass="side-panel-row">
                        <Label text="Distance/min" styleClass="side-panel-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statDistancePerMinLabel" text="0 m/min" styleClass="side-panel-value"/>
                    </HBox>
                    <HBox styleClass="side-panel-row">
                        <Label text="Accélérations" styleClass="side-panel-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statAccelLabel" text="0" styleClass="side-panel-value"/>
                    </HBox>
                    <HBox styleClass="side-panel-row">
                        <Label text="Décélérations" styleClass="side-panel-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statDecelLabel" text="0" styleClass="side-panel-value"/>
                    </HBox>
                    <HBox styleClass="side-panel-row">
                        <Label text="Changements de direction" styleClass="side-panel-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statDirectionChangesLabel" text="0" styleClass="side-panel-value"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
   
</ScrollPane>