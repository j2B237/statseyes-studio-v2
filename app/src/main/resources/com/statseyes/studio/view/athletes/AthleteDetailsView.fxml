<?xml version="1.0" encoding="UTF-8"?>
<?import com.statseyes.studio.presentation.component.StatsCard?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.statseyes.studio.presentation.athletes.details.AthleteDetailsViewController"
      styleClass="athlete-details-root"
      stylesheets="@/com/statseyes/studio/static/css/athlete/athlete-details.css"
      spacing="20" style="-fx-padding: 24;">
    
    <HBox spacing="16" alignment="CENTER_LEFT">
        <Button text="← Retour" onAction="#onBack" styleClass="secondary-button"/>
        <VBox HBox.hgrow="ALWAYS">
            <Label fx:id="athleteNameLabel" styleClass="athlete-name" text="—"/>
            <Label fx:id="athleteSubtitleLabel" styleClass="athlete-subtitle" text="—"/>
        </VBox>
        
        <Button fx:id="importButton" text="Importer dump.bin" onAction="#onImportDump"/>
    </HBox>
    
    <Label fx:id="importStatusLabel" styleClass="import-status"/>
    
    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <StatsCard fx:id="distanceCard" title="Distance parcourue"
                   iconGlyph="📍" accentColor="#4F8EF7"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <StatsCard fx:id="vitesseCard" title="Vitesse max"
                   iconGlyph="🏃" accentColor="#FF5A5F"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <StatsCard fx:id="sprintsCard" title="Sprints"
                   iconGlyph="⚡" accentColor="#FFB020"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <StatsCard fx:id="directionCard" title="Direction dominante"
                   iconGlyph="🧭" accentColor="#34C759"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>
</VBox>